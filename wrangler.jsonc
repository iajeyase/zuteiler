{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zuteiler",
	"main": "src/worker.js",
	"compatibility_date": "2026-01-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zuteiler",
			"database_id": "07eb5179-ca26-4510-98e7-be3f8788638d",
			"migrations_dir": "migrations"
		},
		{
			"binding": "zuteiler",
			"database_name": "zuteiler",
			"database_id": "07eb5179-ca26-4510-98e7-be3f8788638d",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}